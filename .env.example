# Where this dashboard lives (no trailing slash). Example: https://app.firstresponsereviews.com
APP_URL=http://localhost:3000
PORT=3000

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your Webflow site(s) allowed to post the login form here (comma-separated)
WEBFLOW_SITE_URL=https://first-response-reviews.webflow.io
# Webflow form webhook: protect it with a long random key in its URL (at least 24 characters)...
WEBFLOW_WEBHOOK_KEY=
# ...and/or the signing secret Webflow returns if you create the webhook with your own Site API token.
WEBFLOW_WEBHOOK_SECRET=

# Email (https://resend.com). Leave blank to skip sending emails.
RESEND_API_KEY=
EMAIL_FROM=First Response <hello@yourdomain.com>
# Where new trial signups, contact messages and report-ready notices go
TEAM_EMAIL=kaitlyn@beyondsmm.com

# Shared secret for the monthly report job (any random string, at least 24 characters)
CRON_SECRET=

# Optional: Claude rewrites of suggested replies
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
